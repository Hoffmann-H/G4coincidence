#
# Macro file for the initialization phase of "radioActiv.cc"
#
# Sets some default verbose
# and initializes the graphic.
#
/control/verbose 2
/run/verbose 2
#
# Source inside borehole detector, SDD above
#/geometry/setup/TU2 X 0 0 0 39
#/geometry/setup/TU5 X 180 0 0 39

# TU4+TU5 test setup
#/geometry/setup/place TU4 Y -90 17.9 0 0
#/geometry/setup/place TU5 X 0 0 0 -3.0
#/geometry/setup/place sample1 X 0 0 0 0
#/primary/sourceVolumeZcenter 0
#/primary/sourceVolumeThickness 0.137
#/primary/sourceVolumeRadius 11

# Scintillator anti-coincidence setup
#/geometry/setup/place Scint X 0 0 0 0
#/geometry/setup/place TU4 X 0 0 0 -11
#/geometry/setup/place TU2 X 180 0 0 11
#/geometry/setup/place sample2 X 0 0 0 -2.5

# Generic detector setup
#/geometry/setup/place GenericHPGe X 0 0 0 0
#/geometry/setup/place sample2 X 0 0 0 1
#/geometry/setup/place TU3 X 180 0 0 9
#/primary/sourceVolumeZcenter 1
#/primary/sourceVolumeThickness 0.137
#/primary/sourceVolumeRadius 11

# TU5 calibration setup
#/geometry/setup/place TU5 X 0 0 0 0
#/primary/sourceVolumeZcenter 10
#
# Finding the reason for continuous X-ray background
#/geometry/setup/place TU3 X 180 0 0 1

# TU2+TU3 EC0 setups
#/geometry/setup/place TU2 X 0 0 0 0
#/geometry/setup/place TU3 X 180 0 0 14.0
#/geometry/setup/place sample1 X 180 0 0 7.1
#/primary/sourceVolumeZcenter 7.1
#/primary/sourceVolumeThickness 0.137
#/primary/sourceVolumeRadius 11

# TU3 calibration setups
#/geometry/setup/place TU2 X 0 0 0 0
/geometry/setup/place TU3 X 180 0 0 57.5
/geometry/setup/place PTBstandard X 0 0 0 7.5
/primary/sourceVolumeZcenter 7.5
/primary/sourceVolumeYcenter 0
/primary/sourceVolumeRadius 2.5

#/primary/ion 33 76
/primary/gamma 8 keV
/primary/ECbranching 0.0
#/primary/daughterExcitEnergy 562.93 keV
#
/process/em/fluo true
#/process/em/auger true
#/process/em/augerCascade true
#/process/em/pixe true
/run/initialize
#
# Use this open statement to create an OpenGL view:
/vis/open OGL 600x600-0+0
#
# Disable auto refresh and quieten vis messages whilst scene and
# trajectories are established:
/vis/viewer/set/autoRefresh false
/vis/verbose errors
#
# Draw geometry:
/vis/drawVolume
#
# Specify view angle:
# standard for z rotational symmetry
/vis/viewer/set/upVector 0 0 1
/vis/viewer/set/viewpointVector 1 0 0
/vis/viewer/set/lightsVector 0 1 0
# for 2023 TU4+TU5 setup
#/vis/viewer/set/upVector -1 0 0
#/vis/viewer/set/viewpointVector 0 1 0
#/vis/viewer/set/lightsVector 0 1 0
#
# Specify zoom value:
/vis/viewer/zoom 20
#
# Specify style (surface or wireframe):
/vis/viewer/set/style surface
#
# make the world volume transparent
/vis/geometry/set/colour World 0 1 1 1 0.01
#
# Draw smooth trajectories at end of event, showing trajectory points
# as markers 2 pixels wide:
/vis/scene/add/trajectories smooth
#/vis/modeling/trajectories/create/drawByCharge
#/vis/modeling/trajectories/drawByCharge-0/default/setDrawStepPts true
#/vis/modeling/trajectories/drawByCharge-0/default/setStepPtsSize 2
# (if too many tracks cause core dump => /tracking/storeTrajectory 0)
#
# Draw hits at end of event:
#/vis/scene/add/hits
#
# To draw only gammas:
#/vis/filtering/trajectories/create/particleFilter
#/vis/filtering/trajectories/particleFilter-0/add gamma
#
# To invert the above, drawing all particles except gammas,
# keep the above two lines but also add:
#/vis/filtering/trajectories/particleFilter-0/invert true
#
# Many other options are available with /vis/modeling and /vis/filtering.
# For example, to select colour by particle ID:
/vis/modeling/trajectories/create/drawByParticleID
/vis/modeling/trajectories/drawByParticleID-0/set e- red
/vis/modeling/trajectories/drawByParticleID-0/set e+ blue
/vis/modeling/trajectories/drawByParticleID-0/set nu_e orange
/vis/modeling/trajectories/drawByParticleID-0/set anti_nu_e orange
/vis/modeling/trajectories/drawByParticleID-0/set geantino white
/vis/modeling/trajectories/drawByParticleID-0/set gamma green
/vis/modeling/trajectories/drawByParticleID-0/set alpha yellow
/vis/modeling/trajectories/drawByParticleID-0/set GenericIon grey
#
# To superimpose all of the events from a given run:
/vis/scene/endOfEventAction accumulate
#
# Re-establish auto refreshing and verbosity:
/vis/viewer/set/autoRefresh true
/vis/verbose warnings
#
# For file-based drivers, use this to create an empty detector view:
#/vis/viewer/flush
#
# show spatial axes
#/vis/scene/add/axes    # Simple axes: x=red, y=green, z=blue.
#
/vis/viewer/addCutawayPlane 0 0 0 cm -1 0 0