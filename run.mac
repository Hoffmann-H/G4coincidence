/geometry/setup/place VetoSc X 0 0 0 0
/geometry/setup/place sample1 Y 180 0 0 0
/primary/sourceVolumeRadius 11
/primary/sourceVolumeThickness 0.137
/primary/sourceVolumeZcenter 0
